<mujoco model="cartpole">
  <option timestep="0.02" gravity="0 0 -9.81" integrator="RK4"/>

  <default>
    <joint damping="0.05" armature="0.01"/>
    <geom rgba="0.7 0.7 0.75 1"/>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="4 4 0.1" rgba="0.2 0.25 0.3 1"/>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>

    <body name="cart" pos="0 0 0.2">
      <joint name="slider" type="slide" axis="1 0 0" range="-2.4 2.4" limited="true"/>
      <geom name="cart_geom" type="box" size="0.25 0.15 0.08" mass="1"/>

      <body name="pole" pos="0 0 0.08">
        <joint name="hinge" type="hinge" axis="0 1 0" range="-3.14159 3.14159"/>
        <geom name="pole_geom" type="capsule" fromto="0 0 0 0 0 0.6" size="0.04" mass="0.2"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="cart_motor" joint="slider" gear="25" ctrlrange="-1 1" ctrllimited="true"/>
  </actuator>
</mujoco>
